rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile pictures. Each user writes only their own avatar (max 2 MB,
    // images only). Avatars are public so order lists and reviews can show them.
    match /avatars/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
    }
  }
}
